# Supabase frontend config (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA providers e flags de ativação (frontend apenas para feature toggles)
VITE_ENABLE_GEMINI=true
VITE_ENABLE_CEREBRAS=true

# Chaves de IA devem ser definidas no backend/Supabase Secrets
# Nunca exponha estas chaves no frontend.
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
